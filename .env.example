# SafeLink Environment Configuration

# Application
DEBUG=true
ENVIRONMENT=development
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Database
DATABASE_URL=postgresql+asyncpg://safelink:safelink@postgres:5432/safelink

# Redis
REDIS_URL=redis://redis:6379/0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_HOUR=60

# HTTP Client Limits
HTTP_CONNECT_TIMEOUT=5.0
HTTP_TOTAL_TIMEOUT=15.0
HTTP_MAX_REDIRECTS=5
HTTP_MAX_RESPONSE_SIZE=512000
HTTP_MAX_CONCURRENT=10

# Scan Retention (hours)
SCAN_RETENTION_HOURS=24

# Risk Scoring Thresholds
RISK_THRESHOLD_LOW=20
RISK_THRESHOLD_MODERATE=50
RISK_THRESHOLD_SUSPICIOUS=75

# Reputation Providers
# Options: mock, virustotal
REPUTATION_PROVIDER=mock
REPUTATION_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
